{
  "name": "deepclause-sdk",
  "version": "0.5.0",
  "description": "Neuro-symbolic runtime: a self-modifying DML/Prolog REPL, one-shot runner, and TypeScript SDK",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "deepclause": "./dist/cli/index.js",
    "deepclause-repl": "./dist/cli/repl-bin.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./runtime-identity": "./dist/runtime-identity.json",
    "./work": {
      "import": "./dist/work/index.js",
      "types": "./dist/work/index.d.ts"
    },
    "./validate": {
      "import": "./dist/validate.js",
      "types": "./dist/validate.d.ts"
    },
    "./compiler": {
      "import": "./dist/compiler.js",
      "types": "./dist/compiler.d.ts"
    }
  },
  "scripts": {
    "prebuild": "npm run check:agent-prompt && npm run check:docs",
    "build": "tsc && npm run copy:prolog && npm run copy:assets && npm run chmod:bins && npm run stamp:runtime",
    "stamp:runtime": "node scripts/runtime-identity.mjs",
    "check:runtime": "node scripts/runtime-identity.mjs --check",
    "chmod:bins": "chmod +x dist/cli/index.js dist/cli/repl-bin.js",
    "copy:prolog": "mkdir -p dist/prolog-src && cp src/prolog-src/*.pl dist/prolog-src/",
    "copy:assets": "mkdir -p dist/system/assets/docs && cp src/system/assets/docs/*.md dist/system/assets/docs/ && cp src/system/assets/model-database.json dist/system/assets/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build",
    "example": "tsx sdk-examples/quick-start.ts",
    "examples": "tsx sdk-examples/neurosymbolic.ts",
    "examples:smoke": "npm run example && tsx sdk-examples/tools.ts && npm run examples && tsx sdk-examples/judgments.ts && tsx sdk-examples/subagents.ts && tsx sdk-examples/debate.ts",
    "cli": "tsx src/cli/index.ts",
    "repl": "tsx src/cli/index.ts repl",
    "sync:agent-prompt": "node scripts/sync-agent-prompt.mjs",
    "check:agent-prompt": "node scripts/sync-agent-prompt.mjs --check",
    "sync:docs": "node scripts/sync-forms-doc.mjs",
    "check:docs": "node scripts/sync-forms-doc.mjs --check",
    "eval:authoring": "node scripts/eval-authoring.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.35",
    "@ai-sdk/google": "^3.0.60",
    "@ai-sdk/openai": "^3.0.25",
    "@earendil-works/pi-ai": "^1.0.4",
    "@earendil-works/pi-coding-agent": "^1.0.4",
    "@earendil-works/pi-tui": "^1.0.4",
    "@resvg/resvg-js": "^2.6.2",
    "ai": "^6.0.116",
    "commander": "^12.1.0",
    "deepclause-agentvm": "^0.4.0",
    "fflate": "^0.8.3",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^8.57.0",
    "memfs": "^4.56.10",
    "tsx": "^4.21.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist",
    "docs/images",
    "src/prolog-src",
    "vendor/swipl-wasm/dist",
    "vendor/swipl-wasm/package.json",
    "vendor/swipl-wasm/LICENSE.txt"
  ],
  "keywords": [
    "deepclause",
    "dml",
    "prolog",
    "neurosymbolic",
    "ai",
    "llm",
    "agent"
  ],
  "author": "DeepClause",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/deepclause/deepclause-sdk"
  },
  "bugs": {
    "url": "https://github.com/deepclause/deepclause-sdk/issues"
  },
  "homepage": "https://github.com/deepclause/deepclause-sdk#readme"
}
