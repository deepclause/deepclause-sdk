{
  "name": "deepclause-sdk",
  "version": "0.0.86",
  "description": "DeepClause CLI Tool, TUI and Typescript SDK",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "deepclause": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./compiler": {
      "import": "./dist/compiler.js",
      "types": "./dist/compiler.d.ts"
    }
  },
  "scripts": {
    "build": "tsc && npm run copy:prolog && npm run copy:assets",
    "copy:prolog": "cp src/prolog-src/*.pl dist/prolog-src/",
    "copy:assets": "mkdir -p dist/system/assets/skills dist/system/assets/compactors dist/system/assets/docs dist/system/assets/recipes && cp src/system/assets/skills/*.dml dist/system/assets/skills/ && cp src/system/assets/compactors/*.dml dist/system/assets/compactors/ && cp src/system/assets/docs/*.md dist/system/assets/docs/ && cp src/system/assets/model-database.json dist/system/assets/ && cp -R src/system/assets/recipes/. dist/system/assets/recipes/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build",
    "example": "tsx sdk-examples/quick-start.ts",
    "examples": "tsx sdk-examples/basic-usage.ts",
    "examples:smoke": "tsx sdk-examples/no-api-key.ts && npm run example && npm run examples && tsx sdk-examples/neurosymbolic.ts 1 && tsx sdk-examples/deep-research.ts \"test topic\"",
    "cli": "tsx src/cli/index.ts",
    "compaction:probe": "tsx scripts/compaction-probe.ts",
    "benchmark:swebench": "node benchmarks/run-swebench-lite.mjs",
    "benchmark:swebench:prefetch": "node benchmarks/prefetch-swebench-lite.mjs",
    "benchmark:swebench:evaluate": "node benchmarks/evaluate-predictions.mjs",
    "benchmark:deepplanning": "node benchmarks/run-deepplanning.mjs",
    "benchmark:deepplanning:evaluate": "node benchmarks/evaluate-deepplanning.mjs",
    "benchmark:nl2repo": "node benchmarks/run-nl2repo.mjs",
    "benchmark:nl2repo:evaluate": "node benchmarks/evaluate-nl2repo.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.35",
    "@ai-sdk/google": "^3.0.60",
    "@ai-sdk/openai": "^3.0.25",
    "ai": "^6.0.116",
    "commander": "^12.1.0",
    "deepclause-agentvm": "^0.0.5",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^8.57.0",
    "memfs": "^4.56.10",
    "tsx": "^4.21.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "src/prolog-src",
    "vendor/swipl-wasm/dist",
    "vendor/swipl-wasm/package.json",
    "vendor/swipl-wasm/LICENSE.txt"
  ],
  "keywords": [
    "deepclause",
    "dml",
    "prolog",
    "neurosymbolic",
    "ai",
    "llm",
    "agent"
  ],
  "author": "DeepClause",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/deepclause/deepclause-sdk"
  },
  "bugs": {
    "url": "https://github.com/deepclause/deepclause-sdk/issues"
  },
  "homepage": "https://github.com/deepclause/deepclause-sdk#readme"
}
